# OmniGuard V2X: A Privacy-Preserving Blockchain Framework for Smart Vehicle Security
# Developer : Md Shahanur Islam Shagor
# Role      : Project Architect & Lead Developer
# ==============================
# SmartCar Core Identity/Auth
# ==============================
SMARTCAR_VEHICLE_ID=SMARTCAR_VIN_2024_BD_XYZ789
SMARTCAR_AUTH_TOKEN=SECURE_AUTH_TOKEN_SHA3_2024
SMARTCAR_PASSWORD=SmartCarSecretKey2024!@#
SMARTCAR_VALIDATOR_ID=authority_node_1
SMARTCAR_VALIDATOR_KEY=SmartCarPoAKey_2024_Node1
SMARTCAR_SPEED_LIMIT_KMH=120
SMARTCAR_EDGE_ENABLED=1
SMARTCAR_EDGE_WINDOW_SIZE=5
SMARTCAR_EDGE_FLUSH_INTERVAL_SEC=2.0

# Ledger output paths
SMARTCAR_GUI_CHAIN_FILE=logs/blockchain_gui.json
SMARTCAR_CHAIN_FILE_TEST=logs/blockchain_test.json

# ==============================
# V2X (Vehicle-to-Everything)
# ==============================
SMARTCAR_V2X_HOST=127.0.0.1
SMARTCAR_V2X_PORT=9988
SMARTCAR_V2X_AUTOSTART_HUB=1

# ==============================
# Sync Protocol (Vehicle <-> Sync Node)
# ==============================
SMARTCAR_SYNC_HOST=127.0.0.1
SMARTCAR_SYNC_PORT=9876
SMARTCAR_SYNC_SHARED_KEY=SmartCarNetworkKey2024

# ==============================
# Dynamic Smart Contracts
# ==============================
# Enable/disable contract engine
SMART_CONTRACTS_ENABLED=1

# 1 = local mock receipts, 0 = real endpoint call
SMART_CONTRACTS_MOCK_MODE=1
SMART_CONTRACT_TIMEOUT_SEC=4

# Ethereum connector
ETH_RPC_ENDPOINT=http://127.0.0.1:8545
ETH_CHAIN_ID=1337
ETH_CONTRACT_NAME=SmartCarInsuranceAndToll
ETH_PRIVATE_KEY=0xREPLACE_WITH_REAL_PRIVATE_KEY

# Hyperledger Fabric connector
FABRIC_GATEWAY_ENDPOINT=http://127.0.0.1:7050
FABRIC_CHANNEL=mychannel
FABRIC_CHAINCODE_NAME=smartcar_cc
FABRIC_IDENTITY=smartcarOrg1User
FABRIC_MSP_ID=Org1MSP

# Dynamic policy rules
INSURANCE_AUTO_SHARE_ENABLED=1
TOLL_AUTO_PAYMENT_ENABLED=1
MAINTENANCE_CONTRACT_ENABLED=1
TOLL_DEFAULT_FEE=75
MAINTENANCE_TEMP_THRESHOLD=100

# ==============================
# Real Hardware Testing
# ==============================
# SMARTCAR_HW_MODE = arduino | pi
SMARTCAR_HW_MODE=arduino
SMARTCAR_HW_CHAIN_FILE=logs/blockchain_hardware.json

# Arduino serial
SMARTCAR_HW_SERIAL_PORT=COM3
SMARTCAR_HW_SERIAL_BAUD=115200

# Raspberry Pi TCP bridge
SMARTCAR_HW_BRIDGE_HOST=127.0.0.1
SMARTCAR_HW_BRIDGE_PORT=9901

# ZKP performance log
SMARTCAR_ZKP_LATENCY_LOG=logs/zkp_latency.jsonl

# ZKP parameterization (production-oriented)
# SMARTCAR_ZKP_PARAM_SET = RFC3526_GROUP14 | MERSENNE_521
SMARTCAR_ZKP_PARAM_SET=RFC3526_GROUP14
# Optional overrides (decimal or 0x-hex). Keep empty to use selected standard set.
SMARTCAR_ZKP_P=
SMARTCAR_ZKP_G=
SMARTCAR_ZKP_H=

# Local storage encryption for blockchain file
SMARTCAR_STORAGE_ENCRYPTION=1
# Optional dedicated passphrase for file encryption (fallback to SMARTCAR_PASSWORD if empty)
SMARTCAR_STORAGE_PASSPHRASE=
SMARTCAR_STORAGE_KDF_ITERATIONS=200000

# Owner recovery mode (for lockout / chain-compromise recovery)
# Use a strong secret different from SMARTCAR_AUTH_TOKEN in production.
SMARTCAR_OWNER_RECOVERY_KEY=OWNER_RECOVERY_KEY_2026_CHANGE_ME
SMARTCAR_OWNER_ALLOW_CHAIN_RESET=1


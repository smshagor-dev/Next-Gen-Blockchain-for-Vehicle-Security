# OmniGuard V2X local configuration template
#
# Copy this file to .env for local development.
# NEVER commit .env, private keys, recovery keys, tokens, or production secrets.
#
# Generate independent high-entropy secrets, for example:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# v2.4+ credential policy is fail-closed by default:
# - sensitive caller defaults are rejected;
# - configured secrets must meet minimum length/placeholder checks;
# - exact cross-domain secret reuse is rejected;
# - trust registries reject one key reused across multiple identities.
#
# v2.5 adds a key-provider boundary and runtime isolation foundation. The
# environment provider is software-backed. Selecting tpm2/pkcs11/hsm without an
# installed adapter fails closed; it does NOT silently fall back to environment.
#
# v2.6 makes sync identity admission permissioned by default and scopes signed
# validator votes to a fixed validator set and consensus epoch.
#
# v2.7 adds bounded replay-cache saturation behavior plus deterministic
# adversarial/fuzz validation. Replay caches reject new nonces while full rather
# than evicting live entries or growing memory without bound.
#
# v2.8 adds bounded runtime security correlation and software-HIL detection
# validation. v2.9 adds a separately signed incident evidence journal plus
# explicit acknowledgement and recovery gates. No incident-response module
# automatically releases vehicle safe mode or actuates hardware.
#
# v3.2 native C++ security target uses only real liboqs ML-DSA-44/ML-KEM-512
# and OpenSSL AES-256-GCM. The historical XOR/simulated-PQC source is isolated
# behind the explicitly named legacy demo target and is not the supported build.
#
# v3.0.3 development adds a durable encrypted PQC keystore and guarded local
# rotation foundation. The software file provider stores ML-DSA-44/ML-KEM-512
# public keys in plaintext and wraps private key material with a separate
# AES-256-GCM credential. It is not a hardware-backed/non-exportable key provider.

# ---------------------------------------------------------------------------
# Key provider / hardware-backed policy
# ---------------------------------------------------------------------------
SMARTCAR_KEY_PROVIDER=environment
SMARTCAR_REQUIRE_HARDWARE_KEY_PROVIDER=0

# ---------------------------------------------------------------------------
# Required independent security credentials
# ---------------------------------------------------------------------------
SMARTCAR_PASSWORD=
SMARTCAR_AUTH_TOKEN=
SMARTCAR_VALIDATOR_KEY=
SMARTCAR_SYNC_SHARED_KEY=
SMARTCAR_GO_API_SECRET=
SMARTCAR_RECOVERY_KEY=
SMARTCAR_OWNER_RECOVERY_KEY=
SMARTCAR_STORAGE_PASSPHRASE=
SMARTCAR_CPP_DATA_KEY=
SMARTCAR_CPP_PQC_KEYSTORE_KEY=
SMARTCAR_FORENSIC_ACCESS_KEY=
SMARTCAR_INSURANCE_ACCESS_KEY=

# v2.9 incident response uses two independent credentials. The evidence key
# authenticates journal entries; the operator key signs ACKNOWLEDGE/RECOVER
# authorizations. Do not reuse either key with any other security domain.
SMARTCAR_INCIDENT_EVIDENCE_KEY=
SMARTCAR_INCIDENT_OPERATOR_KEY=

# Lab-only compatibility bypass. Keep 0 for normal use.
SMARTCAR_ALLOW_INSECURE_SECRET_DEFAULTS=0

# Rotation foundation. Protocols must explicitly opt into *_PREVIOUS slots.
# SMARTCAR_GO_API_SECRET_PREVIOUS=
# SMARTCAR_VALIDATOR_KEY_PREVIOUS=
# SMARTCAR_CPP_DATA_KEY_PREVIOUS=
# SMARTCAR_CPP_PQC_KEYSTORE_KEY_PREVIOUS=
# SMARTCAR_INCIDENT_EVIDENCE_KEY_PREVIOUS=
# SMARTCAR_INCIDENT_OPERATOR_KEY_PREVIOUS=

# ---------------------------------------------------------------------------
# Permissioned identity / validator registries
# ---------------------------------------------------------------------------
# v2.6 normal policy: enrolled vehicle identities only.
# Missing/invalid policy fails closed rather than silently becoming open registration.
SMARTCAR_IDENTITY_ADMISSION_POLICY=VEHICLE_MANUFACTURER_REGISTRY

# Per-identity sync enrollment is REQUIRED for normal v2.6 network admission.
# Example:
# SMARTCAR_SYNC_VEHICLE_KEYS_JSON={"vehicle-001":"<independent-secret>","vehicle-002":"<independent-secret>"}
SMARTCAR_SYNC_VEHICLE_KEYS_JSON={}

# A single global sync PSK may authenticate lab migration clients only when this
# explicit compatibility switch is 1. Keep 0 for normal use.
SMARTCAR_SYNC_ALLOW_GLOBAL_PSK_ADMISSION=0

# Permissioned PoA / vote-signing authority registry. Validator IDs used below
# must have matching independent keys here.
# Example:
# SMARTCAR_POA_AUTHORITY_REGISTRY_JSON={"validator-01":"<key-1>","validator-02":"<key-2>","validator-03":"<key-3>"}
SMARTCAR_POA_AUTHORITY_REGISTRY_JSON={}

# Active validator membership. Empty falls back to configured authority IDs.
# Example: SMARTCAR_SYNC_VALIDATOR_IDS=validator-01,validator-02,validator-03
SMARTCAR_SYNC_VALIDATOR_IDS=

# ---------------------------------------------------------------------------
# Permissioned consensus v2.6
# ---------------------------------------------------------------------------
SMARTCAR_CONSENSUS_EPOCH=1
SMARTCAR_CONSENSUS_QUORUM_NUMERATOR=2
SMARTCAR_CONSENSUS_QUORUM_DENOMINATOR=3
SMARTCAR_CONSENSUS_PROPOSAL_TTL_SEC=30
SMARTCAR_CONSENSUS_MAX_PROPOSALS=4096

# ---------------------------------------------------------------------------
# Identity / sync-node configuration
# ---------------------------------------------------------------------------
SMARTCAR_VEHICLE_ID=
SMARTCAR_SYNC_HOST=127.0.0.1
SMARTCAR_SYNC_PORT=9876
SMARTCAR_SYNC_REPLAY_WINDOW_SEC=15
SMARTCAR_SYNC_MAX_CHAIN_BLOCKS=10000

# v2.7 nonce-flood bounds. When a live replay cache reaches capacity, new
# authenticated nonces fail closed until old entries expire. Increase only after
# measuring expected authenticated message rate and memory budget.
SMARTCAR_SYNC_REPLAY_CACHE_MAX_ENTRIES=4096
SMARTCAR_SYNC_HANDSHAKE_REPLAY_CACHE_MAX_ENTRIES=4096

# ---------------------------------------------------------------------------
# V2X trust store and replay protection
# ---------------------------------------------------------------------------
SMARTCAR_V2X_HOST=127.0.0.1
SMARTCAR_V2X_PORT=9988
SMARTCAR_V2X_REPLAY_WINDOW_SEC=15
SMARTCAR_V2X_NODE_KEYS_JSON={}
SMARTCAR_V2X_NODE_SECRET=
SMARTCAR_V2X_ALLOW_GLOBAL_PSK=0
SMARTCAR_V2X_SHARED_SECRET=

# ---------------------------------------------------------------------------
# V2X cryptographic posture
# ---------------------------------------------------------------------------
SMARTCAR_V2X_CRYPTO_DEFAULT=DILITHIUM
SMARTCAR_V2X_CRYPTO_FORCE_MODE=
SMARTCAR_V2X_ALLOW_CLASSICAL_ECDH_FALLBACK=0
SMARTCAR_V2X_FORCE_CLASSIC=0
SMARTCAR_V2X_QUANTUM_ALERT=0
SMARTCAR_V2X_PQC_KEM_PREFERRED=ML-KEM-512
SMARTCAR_V2X_PQC_KEM_ALGS=ML-KEM-512,Kyber512
SMARTCAR_V2X_PQC_SIG_ALG=Dilithium2

# ---------------------------------------------------------------------------
# v2.9 incident response / tamper-evident local evidence
# ---------------------------------------------------------------------------
# Evidence is JSONL opened append-only by this process, fsynced per transition,
# mode 0600 where supported, hash chained, and HMAC authenticated. It is not a
# substitute for WORM/remote/hardware-backed forensic storage.
SMARTCAR_INCIDENT_EVIDENCE_DIR=logs/security
SMARTCAR_INCIDENT_EVIDENCE_FILENAME=incident-evidence.jsonl
SMARTCAR_INCIDENT_EVIDENCE_MAX_BYTES=67108864
SMARTCAR_INCIDENT_EVIDENCE_MAX_RECORD_BYTES=16384

# Signed operator authorization is timestamp/nonce bound and replay protected.
SMARTCAR_INCIDENT_OPERATOR_AUTH_WINDOW_SEC=120
SMARTCAR_INCIDENT_OPERATOR_NONCE_CACHE_ENTRIES=1024

# Recovery is never automatic. A prior ACKNOWLEDGE is required, then this many
# consecutive NORMAL/NONE monitor observations. Safety-critical incidents also
# require an explicit external safety-interlock confirmation before RECOVER.
SMARTCAR_INCIDENT_RECOVERY_HEALTHY_OBSERVATIONS=3

# ---------------------------------------------------------------------------
# v3.2 hardened native C++ blockchain target
# ---------------------------------------------------------------------------
# SMARTCAR_CPP_DATA_KEY is configured in the required-credentials section above.
# It is used only by native/secure_blockchain.cpp for AES-256-GCM data-at-rest
# protection. Do not reuse SMARTCAR_PASSWORD or any API, recovery, validator,
# hardware, V2X, incident, storage, or PQC-keystore credential for this domain.
#
# CMake normal build requires a system liboqs package. Reproducible CI/source
# builds can set SMARTCAR_FETCH_PINNED_LIBOQS=ON at configure time; it pins
# liboqs 0.16.0 to commit 5a1a854b0dc9f2141bdc771c555ee60c37950183.
# Historical blockchain.cpp is available only with
# -DSMARTCAR_BUILD_LEGACY_CPP_DEMO=ON and remains lab/compatibility-only.

# ---------------------------------------------------------------------------
# v3.0.3 durable native PQC keystore / local rotation foundation
# ---------------------------------------------------------------------------
# SMARTCAR_CPP_PQC_KEYSTORE_KEY is an independent >=32-character wrapping key
# for encrypted ML-DSA-44 and ML-KEM-512 private key material. Never reuse
# SMARTCAR_CPP_DATA_KEY, SMARTCAR_AUTH_TOKEN, validator, API, recovery, hardware,
# V2X, incident, forensic, insurance, or storage credentials here.
SMARTCAR_CPP_PQC_KEYSTORE_PATH=data/keys/native-pqc-keystore.json
#
# Local key rotation is disabled by default. When explicitly enabled, use only
# the offline/local smartcar_pqc_key_admin command with an exact ROTATE:<key-id>
# confirmation and a written reason. No network or remote rotation endpoint is
# provided by this foundation.
SMARTCAR_CPP_PQC_ROTATION_ENABLED=0
SMARTCAR_CPP_PQC_ROTATION_DIR=
#
# The only implemented provider remains software_encrypted_file. Requiring
# hardware must fail closed until a real TPM2/PKCS#11/HSM provider is added and
# validated; there is no simulated hardware-backed fallback.
SMARTCAR_CPP_PQC_HARDWARE_REQUIRED=0
#
# Provider metadata is intentionally truthful:
# provider=software_encrypted_file, hardware_backed=false, non_exportable=false.

# ---------------------------------------------------------------------------
# Authenticated local Go control backend / runtime isolation
# ---------------------------------------------------------------------------
SMARTCAR_BACKEND=go
SMARTCAR_GO_API_URL=http://127.0.0.1:8787

# The Go child is not a consensus participant. It receives only its control
# secret, data directory, and this local crypto compatibility policy.
SMARTCAR_GO_ALLOW_CLASSICAL_ECDH_FALLBACK=0

# Python fallback is fail-closed by default. Enable only for explicit lab use.
SMARTCAR_BACKEND_ALLOW_PYTHON_FALLBACK=0